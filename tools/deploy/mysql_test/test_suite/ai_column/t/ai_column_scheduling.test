# A failed row's retry delay must not block fresh work in the same table.
connection default;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py start 19125
create database ai_column_scheduling;
call DBMS_AI_SERVICE.CREATE_AI_MODEL('scheduling_model',
  '{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('scheduling_ep',
  '{"ai_model_name":"scheduling_model","url":"http://127.0.0.1:19125/v1/chat/completions","access_key":"scheduling-key","provider":"openai"}');
create table ai_column_scheduling.docs(
  id bigint primary key,
  content varchar(200),
  result varchar(400) AI COLUMN (
    AI_COMPLETE('scheduling_model', content)
  ) WITH (sync_mode='async', max_retries=1)
);
insert into ai_column_scheduling.docs(id, content) values(1, 'retry-once');
let $retry = 100;
let $waiting = 0;
while ($retry)
{
  let $waiting = `select count(*) = 1
    from oceanbase.__all_ai_column_task task
    join oceanbase.__all_table t on t.table_id = task.table_id
    join oceanbase.__all_database d on d.database_id = t.database_id
    where d.database_name = 'ai_column_scheduling'
      and t.table_name = 'docs' and task.state = 3 and task.retry_count = 1
      and task.eligible_ts > now(6)`;
  if ($waiting == 1) { let $retry = 0; }
  if ($waiting == 0) { --real_sleep 0.05
    dec $retry; }
}
eval select $waiting = 1 as failed_row_has_retry_deadline;
insert into ai_column_scheduling.docs(id, content) values(2, 'fresh-work');
let $retry = 100;
let $independent = 0;
while ($retry)
{
  let $independent = `select count(*) = 1
    from ai_column_scheduling.docs
    where id = 2 and result = 'mock:fresh-work'
      and exists (select 1 from oceanbase.__all_ai_column_task task
        join oceanbase.__all_table t on t.table_id = task.table_id
        join oceanbase.__all_database d on d.database_id = t.database_id
        where d.database_name = 'ai_column_scheduling'
          and t.table_name = 'docs' and task.state = 3 and task.retry_count = 1)`;
  if ($independent == 1) { let $retry = 0; }
  if ($independent == 0) { --real_sleep 0.05
    dec $retry; }
}
eval select $independent = 1 as fresh_row_finishes_during_retry_backoff;
let $retry = 100;
let $done = 0;
while ($retry)
{
  let $done = `select count(*) = 2 from ai_column_scheduling.docs where result is not null`;
  if ($done == 1) { let $retry = 0; }
  if ($done == 0) { --real_sleep 0.05
    dec $retry; }
}
eval select $done = 1 as retry_eventually_finishes;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py assert 19125 retry-once
drop table ai_column_scheduling.docs;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('scheduling_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('scheduling_model');
drop database ai_column_scheduling;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py stop 19125
