create database ai_column_scheduling;
call DBMS_AI_SERVICE.CREATE_AI_MODEL('scheduling_model',
'{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('scheduling_ep',
'{"ai_model_name":"scheduling_model","url":"http://127.0.0.1:19125/v1/chat/completions","access_key":"scheduling-key","provider":"openai"}');
create table ai_column_scheduling.docs(
id bigint primary key,
content varchar(200),
result varchar(400) AI COLUMN (
AI_COMPLETE('scheduling_model', content)
) WITH (sync_mode='async', max_retries=100)
);
insert into ai_column_scheduling.docs(id, content)
values(1, 'retry-until-fresh'), (2, 'fresh-work');
select 1 = 1 as fresh_work_unblocks_retry;
fresh_work_unblocks_retry
1
mock_fresh_before_retry=ok
call DBMS_AI_SERVICE.CREATE_AI_MODEL('scheduling_fail_model',
'{"type":"completion","model_name":"mock-fail"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('scheduling_fail_ep',
'{"ai_model_name":"scheduling_fail_model","url":"http://127.0.0.1:19125/v1/always-fail/completions","access_key":"scheduling-key","provider":"openai"}');
create database ai_column_other;
create table ai_column_other.docs(
id bigint primary key,
content varchar(200),
result varchar(400) AI COLUMN (
AI_COMPLETE('scheduling_fail_model', content)
) WITH (sync_mode='async', max_retries=0)
);
insert into ai_column_other.docs(id, content) values(1, 'unfinished');
set session ai_column_strict_read = on;
select count(*) = 2 as unrelated_failure_does_not_block_ready_column
from ai_column_scheduling.docs where result is not null;
unrelated_failure_does_not_block_ready_column
1
select count(*) = 1 as qualified_ready_column_in_join
from ai_column_scheduling.docs a join ai_column_other.docs b on a.id = b.id
where a.result is not null;
qualified_ready_column_in_join
1
select count(*) = 1 as count_star_does_not_read_ai_result from ai_column_other.docs;
count_star_does_not_read_ai_result
1
select 'result' as literal_is_not_a_column from ai_column_other.docs;
literal_is_not_a_column
result
use ai_column_scheduling;
select count(*) = 2 as unqualified_table_uses_current_database from `docs` where result is not null;
unqualified_table_uses_current_database
1
select result from ai_column_other.docs;
ERROR HY000: AI column has unfinished tasks for table_id=<table_id>, column_id=<column_id>
select * from ai_column_other.docs;
ERROR HY000: AI column has unfinished tasks for table_id=<table_id>, column_id=<column_id>
set session ai_column_strict_read = off;
use test;
drop table ai_column_other.docs;
drop database ai_column_other;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('scheduling_fail_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('scheduling_fail_model');
drop table ai_column_scheduling.docs;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('scheduling_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('scheduling_model');
drop database ai_column_scheduling;
